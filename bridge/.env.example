# Configuración del PUENTE (se pone en el VPS, no en el dashboard).
# A dónde sondea la cola y postea los mensajes entrantes:
DASHBOARD_URL=https://dashboard.corpprojects.es
# El MISMO secreto que BRIDGE_TOKEN en el dashboard (header X-Bridge-Token):
BRIDGE_TOKEN=
# Cada cuántos ms sondea la cola de salida (opcional):
POLL_MS=2000
