# ─────────────────────────────────────────────────────────────────────────
# Corp Projects Dashboard — plantilla de variables de entorno
# Copia este fichero a `.env` (local) o cárgalas en Railway → Variables.
# NUNCA subas el `.env` real al repositorio.
# ─────────────────────────────────────────────────────────────────────────

# ── Infraestructura / autenticación ──────────────────────────────────────
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/corpprojects
JWT_SECRET=cadena_aleatoria_larga_y_secreta
DASHBOARD_PASSWORD=contraseña_del_panel_admin
PORT=3000
WORKER_TOKEN_HOURS=168            # duración de la sesión del trabajador (h). 168 = 7 días
# Dominio propio: define esto SOLO cuando dashboard.corpprojects.es esté activo.
# Al definirlo, la URL cruda de Railway redirige (302) al dominio propio.
# Déjalo vacío hasta que el dominio funcione, o te quedas sin acceso.
CANONICAL_HOST=                   # ej: dashboard.corpprojects.es

# ── StelOrder (ERP) ──────────────────────────────────────────────────────
STELORDER_API_KEY=tu_api_key_de_stelorder
STEL_ITEM_DESC_MAX=              # (opcional) límite de caracteres en descripción de línea
STEL_OCR_EMAIL=                  # (opcional) email para OCR de documentos
STEL_PDF_GAP_MS=                 # (opcional) ms de espera entre descargas de PDF
# TTL de caché por recurso (ms) — opcionales, tienen valores por defecto en código
STEL_TTL_BANK=
STEL_TTL_CLIENTS=
STEL_TTL_DOCSTATES=
STEL_TTL_ESTIMATES=
STEL_TTL_EXPENSES=
STEL_TTL_FAMILIES=
STEL_TTL_INCIDENTS=
STEL_TTL_INCTYPES=
STEL_TTL_PDFPATH=
STEL_TTL_PURCHASES=
STEL_TTL_RECEIPTS=
STEL_TTL_SUPPLIERS=
STEL_TTL_WORKORDERS=

# ── Email (SMTP saliente) ────────────────────────────────────────────────
EMAIL_HOST=mail.corpprojects.es
EMAIL_PORT=587
EMAIL_USER=hola@corpprojects.es
EMAIL_PASS=contraseña_o_app_password
EMAIL_FROM=Corp Projects <hola@corpprojects.es>
EMAIL_ADMIN=corpy@corpprojects.es    # destinatario de resúmenes internos
EMAIL_AVISOS=                        # (opcional) destinatario de avisos de cobro
EMAIL_PEDIDOS=                       # (opcional) destinatario del aviso diario de pedidos
EMAIL_IA_DAILY_LIMIT=                # (opcional) tope diario de clasificaciones IA de email
EMAIL_IA_MODEL=                      # (opcional) modelo IA para clasificar emails

# ── Google (Gmail + Calendar) ────────────────────────────────────────────
GMAIL_CLIENT_ID=xxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=tu_client_secret
GMAIL_REDIRECT_URI=https://dashboard.corpprojects.es/auth/google/callback
GMAIL_REFRESH_TOKEN=tu_refresh_token
GCAL_CALENDAR_ID=                # (opcional) id del calendario a sincronizar
GCAL_EVENT_MINUTES=              # (opcional) duración por defecto de eventos creados

# ── Correo / Gestoría (Fase 6) ───────────────────────────────────────────
# GESTORIA_EMAILS: remitentes de la GESTORÍA (coma-separado). AUTORITATIVO por
# remitente: un correo suyo se clasifica GESTORIA y avisa al owner al instante.
# "@dominio.com" casa por dominio; un email completo, exacto. Ej.: @somassessors.com
GESTORIA_EMAILS=

# ── IA (Anthropic) y voz (STT) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx
PRESU_IA_MODEL=                  # (opcional) modelo IA para presupuestos
STT_API_KEY=                     # (opcional) clave del servicio de transcripción de voz
STT_BASE_URL=https://api.openai.com/v1   # (opcional) endpoint STT compatible OpenAI
STT_MODEL=whisper-1              # (opcional) modelo de transcripción

# ── Twilio / WhatsApp ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_VALIDATE: validación de firma del webhook. off | log (default) | enforce.
#   'log' valida y avisa en logs si no cuadra pero procesa igual (rollout seguro);
#   'enforce' rechaza (403) lo no firmado. Pon 'enforce' tras verificar en 'log'.
TWILIO_VALIDATE=log
# TWILIO_WEBHOOK_URL: la URL pública EXACTA que Twilio llama (para validar la firma).
# Si se deja vacía se reconstruye como https://<host>/api/whatsapp.
TWILIO_WEBHOOK_URL=https://dashboard.corpprojects.es/api/whatsapp
MI_WHATSAPP=whatsapp:+34XXXXXXXXX    # número del dueño (filtro del webhook entrante)
WHATSAPP_TO=whatsapp:+34XXXXXXXXX    # destinatario de avisos proactivos

# ── Control de acceso del asistente (src/acceso.js) ───────────────────────
# OWNER_NUMBERS: número(s) del OWNER, separados por coma. El owner tiene acceso
# total; las acciones que tocan DINERO piden PIN + confirmación.
# Nota: si se deja vacío, se usa MI_WHATSAPP/WHATSAPP_TO como red de seguridad,
# de modo que el owner NUNCA queda fuera. Aun así, conviene fijarlo explícito.
OWNER_NUMBERS=whatsapp:+34XXXXXXXXX
# OWNER_PIN: PIN para autorizar acciones de dinero. Si se deja vacío, se usa el
# PIN del usuario admin (src/users.js). Si NO hay ningún PIN configurado, el
# owner igualmente puede actuar pero se le pide confirmación explícita (sí/no).
OWNER_PIN=

# ── Canal de WhatsApp (Fase 8: puente Baileys pull/solo-salida) ───────────
# CANAL_WHATSAPP: transporte de SALIDA. 'twilio' (default) = comportamiento actual.
# 'bridge' = encolar en Mongo (whatsappOutbox); el puente lo recoge por pull.
CANAL_WHATSAPP=twilio
# BRIDGE_TOKEN: secreto compartido puente↔dashboard. Es la ÚNICA barrera de
# /api/bridge/inbound y /api/bridge/outbox (header X-Bridge-Token). El `from` del
# payload entrante decide identidad → de confianza SOLO por el token. Sin este
# valor, ambos endpoints responden 401 siempre. Usa un secreto largo y aleatorio.
BRIDGE_TOKEN=
# NOTA: el dashboard ya NO necesita BRIDGE_URL (el puente no expone puertos).
# El SERVICIO PUENTE (carpeta bridge/, en el VPS) necesita su propia config:
#   DASHBOARD_URL=https://dashboard.corpprojects.es   (a dónde sondea/postea)
#   BRIDGE_TOKEN=<el mismo secreto de arriba>
# Ver bridge/README.md para desplegarlo en el Docker Manager de Hostinger.

# ── Cron / umbrales de alerta ────────────────────────────────────────────
AVISO_CRON=0 8 * * 1             # aviso proactivo semanal (lun 08:00)
ACTIVITY_CRON=*/15 * * * *       # escaneo de actividad StelOrder
AVISO_DIAS_PRESU=                # días para avisar de presupuesto aceptado parado
AVISO_DIAS_SINFACT=              # días de trabajo terminado sin facturar
AVISO_DIAS_VENCIDA=              # días para considerar factura vencida
AVISO_SOLO_SI_HAY=               # si "true", no envía cuando no hay nada que avisar
COBROS_DIAS_NARANJA=             # umbral ámbar de cobros (días)
COBROS_DIAS_ROJO=                # umbral rojo de cobros (días)
ALERT_WARNING_DAYS=15
ALERT_SECOND_DAYS=30
ALERT_URGENT_DAYS=45
ALERT_CRITICAL_DAYS=60
WO_ACT_AMBER=2                   # pedido tipo actuación: ámbar a partir de día 2
WO_ACT_RED=3                     # pedido tipo actuación: rojo a partir de día 3
WO_PRE_AMBER=7                   # pedido tipo presupuesto: ámbar a partir de día 7
WO_PRE_RED=15                    # pedido tipo presupuesto: rojo a partir de día 15

NODE_ENV=production
